# Copy to .env.local (not committed). Restart `npx expo start --clear` after changes.
# Everything EXPO_PUBLIC_ ships inside the app: never put a secret here.

# Which backend Chat, Updates and sign-in use: server (default) or supabase (the earlier pilot, kept as a fallback).
EXPO_PUBLIC_BACKEND=server

# Bell Space server (server/README.md). On a phone, use this computer's Wi-Fi address,
# not localhost, and start the server with HOST=0.0.0.0.
EXPO_PUBLIC_SERVER_URL=http://192.168.0.10:8787

# Supabase pilot (only when EXPO_PUBLIC_BACKEND=supabase; see PILOT_SETUP.md):
# Project Settings → API → Project URL and the publishable / anon key. Never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
